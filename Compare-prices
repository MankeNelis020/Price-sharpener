  ]);
}

// Leest de headerregel en geeft een mapping van lowercased headernaam naar index
function headerMap_(headers) {
  const map = {};
  headers.forEach(function (h, i) {
    const key = String(h || '').trim().toLowerCase();
    if (key) map[key] = i;
  });
  return map;
}

// Ontdekt concurrenten voor alle producten in het overzichtsblad en vult "Concurrenten-2"
function discoverCompetitorsForAllProducts() {
  const ss = SpreadsheetApp.getActive();
  const overview = ss.getSheetByName(SHEETS.OVERZICHT);
  if (!overview) throw new Error('Tabblad ' + SHEETS.OVERZICHT + ' ontbreekt.');

  const lastRow = overview.getLastRow();
  if (lastRow < 2) return;

  const headers = overview.getRange(1, 1, 1, overview.getLastColumn()).getValues()[0];
  const map = headerMap_(headers);
  const idxProductId = map['productid'];
  const idxProduct = map['product'];
  const idxMainUrl = map['url 1'] != null ? map['url 1'] : map['url'];
  if (idxProductId == null || idxProduct == null) {
    throw new Error('Kolommen "ProductId" en "Product" zijn vereist in ' + SHEETS.OVERZICHT + '.');
  }

  const data = overview.getRange(2, 1, lastRow - 1, headers.length).getValues();
  data.forEach(function (row) {
    const productId = String(row[idxProductId] || '').trim();
    const name = String(row[idxProduct] || '').trim();
    const mainUrl = idxMainUrl == null ? '' : String(row[idxMainUrl] || '').trim();
    if (!productId && !name) return;
    discoverCompetitorsForProduct_({ productId: productId, name: name, mainUrl: mainUrl });
  });
}

// Ontdekt concurrent-URLs per product en schrijft/updatet ze in "Concurrenten-2"
function discoverCompetitorsForProduct_(mainProduct) {
  const query = chooseSearchQuery_(mainProduct);
  if (!query) return;
  const sh = ensureConcurrentSheet_();
  const existing = buildCompetitorIndex_(sh);

  Object.keys(SHOP_SEARCH).forEach(function (key) {
    const shop = SHOP_SEARCH[key];
    if (!shop || !shop.searchTemplate) return;

    const searchUrl = shop.searchTemplate.replace('{QUERY}', encodeURIComponent(query));
    var resp;
    try {
      resp = UrlFetchApp.fetch(searchUrl, { muteHttpExceptions: true, followRedirects: true });
    } catch (e) {
      Logger.log('DISCOVER fetch error [' + key + '] ' + e);
      return;
    }
    Utilities.sleep(300);
    if (resp.getResponseCode() !== 200) return;

    const html = resp.getContentText();
    const candidates = extractProductUrlsFromSearch_(key, html, shop) || [];
    candidates.forEach(function (rawUrl) {
      const normalized = normalizeCandidateUrl_(rawUrl, shop);
      if (!normalized || isBlacklistedDomain_(normalized)) return;

      const match = verifyProductMatch_(mainProduct, normalized, shop);
      if (!match || !match.matched) return;

      const indexKey = makeKey_(mainProduct.productId || mainProduct.name, shop.displayName);
      const rowInfo = existing.get(indexKey);
      if (rowInfo) {
        const currentUrl = rowInfo.values[3];
        if (currentUrl !== normalized) {
          sh.getRange(rowInfo.row, 4).setValue(normalized);
          existing.set(indexKey, { row: rowInfo.row, values: [rowInfo.values[0], rowInfo.values[1], rowInfo.values[2], normalized, rowInfo.values[4], rowInfo.values[5]] });
        }
      } else {
        sh.appendRow([
          mainProduct.productId,
          mainProduct.name,
          shop.displayName,
          normalized,
          '',
          ''
        ]);
        const newRow = sh.getLastRow();
        existing.set(indexKey, { row: newRow, values: [mainProduct.productId, mainProduct.name, shop.displayName, normalized, '', ''] });
      }
    });
  });
}

// Bouwt een index van bestaande concurrenten (per product + shop)
function buildCompetitorIndex_(sh) {
  const idx = new Map();
  const last = sh.getLastRow();
  if (last < 2) return idx;
  const vals = sh.getRange(2, 1, last - 1, 6).getValues();
  vals.forEach(function (row, i) {
    const key = makeKey_(row[0], row[2]);
    idx.set(key, { row: i + 2, values: row });
  });
  return idx;
}

// Bepaalt de beste zoekquery (GTIN > productnaam)
function chooseSearchQuery_(mainProduct) {
  var productId = String(mainProduct.productId || '').trim();
  if (/^\d{10,14}$/.test(productId)) return productId;
  var name = String(mainProduct.name || '').trim();
  if (name) return name;
  return '';
}

// Haalt mogelijke product-URLs uit een zoekresultaat-HTML
function extractProductUrlsFromSearch_(shopKey, html, shopConfig) {
  var urls = [];
  try {
    if (!html || !shopConfig || !shopConfig.domain) {
      Logger.log('EXTRACT [' + shopKey + '] missing html or domain');
      return [];
    }

    var domain = shopConfig.domain.replace(/^www\./, '').toLowerCase();
    var seen = {};
    var rawCount = 0;

    function hostMatchesDomain_(host, baseDomain) {
      var cleanHost = String(host || '').replace(/^www\./, '').toLowerCase();
      var cleanBase = String(baseDomain || '').replace(/^www\./, '').toLowerCase();
      if (!cleanHost || !cleanBase) return false;
      if (cleanHost.indexOf(cleanBase) !== -1) return true;
      var flatHost = cleanHost.replace(/[^a-z0-9]/g, '');
      var flatBase = cleanBase.replace(/[^a-z0-9]/g, '');
      return flatHost.indexOf(flatBase) !== -1;
    }

    // Alle anchors pakken, we filteren daarna
    var re = /<a[^>]+href=["']([^"']+)["'][^>]*>/gi;
    var m;
    while ((m = re.exec(html)) !== null && urls.length < 15 && rawCount < 800) {
      rawCount++;
      var href = m[1];
      if (!href) continue;

      href = href.replace(/&amp;/g, '&');

      // Direct wat pure rommel skippen
      if (/^#/i.test(href)) continue;
      if (/^(mailto:|tel:|javascript:)/i.test(href)) continue;

      // Naar absolute URL normaliseren
      var abs = href;
      if (href.indexOf('//') === 0) {
        abs = 'https:' + href;
      } else if (href.indexOf('/') === 0) {
        abs = 'https://' + domain + href;
      } else if (!/^https?:\/\//i.test(href)) {
        abs = 'https://' + domain + (href.charAt(0) === '/' ? '' : '/') + href;
      }

      try {
        var u = new URL(abs);
        if (!hostMatchesDomain_(u.hostname, domain)) continue;

        var path = u.pathname || '/';

        // Navigatie / account / cart / search / service skippen
        if (/\/(account|customer|login|register|cart|winkelwagen|wishlist|search|zoeken|klantenservice|service)\b/i.test(path)) {
          continue;
        }

        // Dubbele links negeren
        if (seen[abs]) continue;
        seen[abs] = true;

        urls.push(abs);
      } catch (e) {
        // kapotte URL -> negeren
      }
    }

    Logger.log(
      'EXTRACT [' + shopKey + '] domain=' + shopConfig.domain +
      ' → ' + urls.length + ' product candidates (raw hrefs=' + rawCount + ')'
    );
    urls.slice(0, 3).forEach(function (u, idx) {
      Logger.log('EXTRACT [' + shopKey + '] candidate #' + (idx + 1) + ': ' + u);
    });

    return urls;
  } catch (e) {
    Logger.log('EXTRACT error for ' + shopKey + ': ' + e);
    return [];
  }
}

// Normaliseert een gevonden URL naar een absolute https-URL
function normalizeCandidateUrl_(url, shopConfig) {
  if (!url) return '';
  var out = url.trim();
  if (out.startsWith('//')) {
    out = 'https:' + out;
  } else if (out.startsWith('/')) {
    out = 'https://' + (shopConfig && shopConfig.domain ? shopConfig.domain : '') + out;
  } else if (!/^https?:\/\//i.test(out)) {
    out = 'https://' + out;
  }
  return out;
}

// Heuristisch: lijkt de URL op een productdetailpagina in plaats van navigatie?
function isProbableProductPath_(url) {
  try {
    var parsed = new URL(url);
    var path = parsed.pathname || '';
    if (!path || path === '/' || /\.(svg|png|jpg|jpeg|gif)$/i.test(path)) return false;
    if (/\b(account|customer|login|register|cart|winkelwagen|search|zoeken)\b/i.test(path)) return false;
    if (path.split('/').length < 2) return false;
    return true;
  } catch (e) {
    return false;
  }
}

// Controleert of een URL op de blacklist staat
function isBlacklistedDomain_(url) {
try {
  var host = new URL(url).hostname.toLowerCase();
  return host.indexOf('bol.com') !== -1;
} catch (e) {
  return true;
  }
}

// Verifieert of een kandidaat-URL matcht met het hoofdproduct (GTIN of naam)
function verifyProductMatch_(mainProduct, url, shopConfig) {
  try {
    var resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
    Utilities.sleep(300);
    var code = resp.getResponseCode();
    if (code !== 200) {
      Logger.log('verifyProductMatch_ HTTP ' + code + ' for ' + url);
      return { matched: false };
    }
    var html = resp.getContentText();

    var productId = String(mainProduct.productId || '').trim();
    if (productId && /^\d{10,14}$/.test(productId)) {
      var gtins = extractGtinsFromHtml_(html);
      if (html.indexOf(productId) !== -1 || gtins.indexOf(productId) !== -1) {
        Logger.log('MATCH ' + productId + ' ← ' + (shopConfig && shopConfig.displayName ? shopConfig.displayName : '') + ' | ' + url);
        return { matched: true, gtin: productId, title: extractProductName_(html) || mainProduct.name || '' };
      }
    }

    var scrapedName = extractProductName_(html) || '';
    if (scrapedName && namesLikelyMatchFlexible_(mainProduct.name, scrapedName)) {
      Logger.log('MATCH ' + (mainProduct.productId || mainProduct.name) + ' ← ' + (shopConfig && shopConfig.displayName ? shopConfig.displayName : '') + ' | ' + url);
      return { matched: true, title: scrapedName, gtin: '' };
    }
  } catch (e) {
    Logger.log('verifyProductMatch_ error for ' + url + ': ' + e);
  }
  return { matched: false };
}

// Probeert een productnaam uit HTML te halen (JSON-LD of H1)
function extractProductName_(html) {
  try {
    var ldMatches = html.match(/<script[^>]*type="application\/ld\+json"[^>]*>([\s\S]*?)<\/script>/gi) || [];
    for (var i = 0; i < ldMatches.length; i++) {
      var txt = ldMatches[i].replace(/<[^>]+>/g, '');
      var obj = JSON.parse(txt);
      if (obj && obj.name) return obj.name;
      if (obj && obj['@graph']) {
        for (var j = 0; j < obj['@graph'].length; j++) {
          if (obj['@graph'][j].name) return obj['@graph'][j].name;
        }
      }
      if (Array.isArray(obj)) {
        for (var k = 0; k < obj.length; k++) {
          if (obj[k] && obj[k].name) return obj[k].name;
        }
      }
    }
  } catch (e) {
    // ignore
  }
  var h1 = html.match(/<h1[^>]*>([^<]+)<\/h1>/i);
  if (h1) return h1[1];
  var title = html.match(/<title[^>]*>([^<]+)<\/title>/i);
  if (title) return title[1];
  return '';
}

// Extraheert mogelijke GTIN/EAN waarden uit HTML (JSON-LD of attributen)
function extractGtinsFromHtml_(html) {
  var gtins = [];
  try {
    var ldMatches = html.match(/<script[^>]*type="application\/ld\+json"[^>]*>([\s\S]*?)<\/script>/gi) || [];
    for (var i = 0; i < ldMatches.length; i++) {
      var txt = ldMatches[i].replace(/<[^>]+>/g, '');
      var obj = JSON.parse(txt);
      var candidates = [];
      if (Array.isArray(obj)) {
        candidates = obj;
      } else if (obj && obj['@graph']) {
        candidates = obj['@graph'];
      } else if (obj) {
        candidates = [obj];
      }
      candidates.forEach(function (item) {
        if (!item) return;
        ['gtin', 'gtin8', 'gtin12', 'gtin13', 'gtin14', 'sku', 'productId'].forEach(function (key) {
          var val = item[key];
          if (val && /^\d{8,14}$/.test(String(val))) {
            gtins.push(String(val));
          }
        });
      });
    }
  } catch (e) {
    // ignore
  }
  var attrMatch = html.match(/(data-[a-z]*ean|data-gtin|itemprop="gtin13"|itemprop='gtin13')[^>]*?(\d{8,14})/gi) || [];
  attrMatch.forEach(function (m) {
    var numMatch = (m.match(/(\d{8,14})/) || [])[1];
    if (numMatch) gtins.push(numMatch);
  });
  return gtins.filter(function (val, idx, arr) { return arr.indexOf(val) === idx; });
}

// Eenvoudige naamvergelijking
function namesLikelyMatch_(a, b) {
  var na = normalizeName_(a);
  var nb = normalizeName_(b);
  if (!na || !nb) return false;
  return nb.indexOf(na) !== -1 || na.indexOf(nb) !== -1;
}

// Meer vergevingsgezinde naamvergelijking voor discovery (token overlap)
function namesLikelyMatchFlexible_(a, b) {
  var na = normalizeName_(a);
  var nb = normalizeName_(b);
  if (!na || !nb) return false;
  if (na.indexOf(nb) !== -1 || nb.indexOf(na) !== -1) return true;
  var tokensA = na.split(/\s+/).filter(function (t) { return t.length > 2; });
  var tokensB = nb.split(/\s+/).filter(function (t) { return t.length > 2; });
  if (!tokensA.length || !tokensB.length) return false;
  var setB = {};
  tokensB.forEach(function (t) { setB[t] = true; });
  var overlap = tokensA.filter(function (t) { return setB[t]; }).length;
  var threshold = Math.max(1, Math.floor(Math.min(tokensA.length, tokensB.length) * 0.5));
  return overlap >= threshold;
}

// Normaliseert productnamen voor vergelijking
function normalizeName_(s) {
  if (!s) return '';
  return s.toString()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

// Controleert prijzen van concurrenten in "Concurrenten-2" en stuurt mails bij wijzigingen
function checkCompetitorPricesAndNotify() {
  var sh = ensureConcurrentSheet_();
  var last = sh.getLastRow();
  if (last < 2) return;

  var vals = sh.getRange(2, 1, last - 1, 6).getValues();
  var updates = [];
  var changesByProduct = {};
  var now = new Date();

  for (var i = 0; i < vals.length; i++) {
    var row = vals[i];
    var productId = String(row[0] || '').trim();
    var productName = String(row[1] || '').trim();
    var shopName = String(row[2] || '').trim();
    var url = String(row[3] || '').trim();
    var lastPrice = row[4];
    var newPrice = lastPrice;
    var newChecked = row[5];

    if (!productId || !url) {
      updates.push([lastPrice, newChecked]);
      continue;
    }

    var result = safeFetchAndExtract(url) || {};
    if (result.price == null) {
      updates.push([lastPrice, now]);
      continue;
    }

    newPrice = result.price;
    newChecked = now;

    if (lastPrice === '' || lastPrice == null) {
      updates.push([newPrice, newChecked]);
    } else if (newPrice !== lastPrice) {
      var diff = newPrice - lastPrice;
      if (!changesByProduct[productId]) changesByProduct[productId] = [];
      changesByProduct[productId].push({
        shopName: shopName,
        oldPrice: lastPrice,
        newPrice: newPrice,
        diff: diff,
        url: url,
        productName: productName
      });
      updates.push([newPrice, newChecked]);
    } else {
      updates.push([lastPrice, newChecked]);
    }
  }

  sh.getRange(2, 5, updates.length, 2).setValues(updates);

  Object.keys(changesByProduct).forEach(function (productId) {
    sendCompetitorChangeMail_(productId, changesByProduct[productId]);
  });
}

// Stuurt één mail per productId met alle prijswijzigingen bij concurrenten
function sendCompetitorChangeMail_(productId, changesArray) {
  if (!changesArray || !changesArray.length) return;
  var mainProduct = findMainProductById_(productId) || {};
  var subject = '[Prijswijziging concurrent] ' + (mainProduct.name || productId);

  var rows = changesArray.slice().sort(function (a, b) { return a.newPrice - b.newPrice; }).map(function (c) {
    return '<tr>' +
      '<td>' + c.shopName + '</td>' +
      '<td>€ ' + formatPrice_(c.oldPrice) + '</td>' +
      '<td>€ ' + formatPrice_(c.newPrice) + '</td>' +
      '<td>€ ' + formatPrice_(c.diff) + '</td>' +
      '<td><a href="' + c.url + '">' + 'Link' + '</a></td>' +
      '</tr>';
  }).join('');

  var intro = '<p>Product: ' + (mainProduct.name || productId) + '</p>';
  if (mainProduct.mainUrl) {
    intro += '<p>Hoofd-URL: <a href="' + mainProduct.mainUrl + '">' + mainProduct.mainUrl + '</a></p>';
  }

  var body = intro + '<table border="1" cellpadding="6" cellspacing="0">' +
    '<tr><th>Shop</th><th>Oude prijs</th><th>Nieuwe prijs</th><th>Verschil</th><th>URL</th></tr>' +
    rows +
    '</table>';

  var recipient = Session.getActiveUser().getEmail();
  MailApp.sendEmail({
    to: recipient,
    subject: subject,
    htmlBody: body
  });
}

// Zoekt het hoofdproduct op basis van ProductId in Overzicht
function findMainProductById_(productId) {
  if (!productId) return null;
  var ss = SpreadsheetApp.getActive();
  var overview = ss.getSheetByName(SHEETS.OVERZICHT);
  if (!overview) return null;
  var last = overview.getLastRow();
  if (last < 2) return null;
  var headers = overview.getRange(1, 1, 1, overview.getLastColumn()).getValues()[0];
  var map = headerMap_(headers);
  var idxId = map['productid'];
  var idxName = map['product'];
  var idxUrl = map['url 1'] != null ? map['url 1'] : map['url'];
  if (idxId == null) return null;
  var data = overview.getRange(2, 1, last - 1, headers.length).getValues();
  for (var i = 0; i < data.length; i++) {
    if (String(data[i][idxId] || '').trim() === productId) {
      return {
        rowIndex: i + 2,
        productId: productId,
        name: idxName == null ? '' : data[i][idxName],
        mainUrl: idxUrl == null ? '' : data[i][idxUrl]
      };
    }
  }
  return null;
}

// Formatteert prijzen naar string met 2 decimalen
function formatPrice_(n) {
  if (n == null || n === '') return '';
  return Number(n).toFixed(2);
}

// Optionele helper om een dagelijkse trigger te maken voor de concurrent-check
function scheduleCompetitorCheckDaily() {
  ScriptApp.newTrigger('checkCompetitorPricesAndNotify')
    .timeBased()
    .everyDays(1)
    .create();
}
