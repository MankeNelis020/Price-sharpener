const SHEET_SNAPSHOT      = 'Concurrenten'; // "Tabblad B"
const SERPAPI_KEY         = PropertiesService.getScriptProperties().getProperty('SERPAPI_API_KEY');

// Whitelist (namen én domeinen; varianten/aliases inbegrepen)
