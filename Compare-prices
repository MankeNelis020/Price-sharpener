/***** CONSTANTS / HEADERS *****/
var SHEET_INPUT = 'Blad1';

var REQUIRED_HEADERS = [
  { key: 'url', name: 'URL' },
  { key: 'category', name: 'Categorie' },
  { key: 'product', name: 'Product' },
  { key: 'productId', name: 'ProductId' },
  { key: 'brand', name: 'Merk' },
  { key: 'model', name: 'Model' },
  { key: 'lastPrice', name: 'Laatste prijs' },
  { key: 'previousPrice', name: 'Vorige prijs' },
  { key: 'lowestPrice', name: 'Laagste prijs' },
  { key: 'pctDrop', name: '% daling' },
  { key: 'watch', name: 'Watch' },
  { key: 'lastCheck', name: 'Laatst gecheckt' },
  { key: 'title', name: 'Titel (scraped)' },
  { key: 'brandScraped', name: 'Merk (scraped)' },
  { key: 'ids', name: 'Ids (scraped)' },
  { key: 'status', name: 'Status' },
  { key: 'debug', name: 'Debug' }
];

var STATUS = {
  OK: 'OK',
  HTTP_403: 'HTTP_403',
  HTTP_429: 'HTTP_429',
  JS_REQUIRED: 'JS_REQUIRED',
  BLOCKED: 'BLOCKED',
  PRICE_NOT_FOUND: 'PRICE_NOT_FOUND',
  PARSE_ERROR: 'PARSE_ERROR',
  UNSUPPORTED: 'UNSUPPORTED'
};

var DOMAIN_PARSERS = {
  'beliani.nl': parseBeliani_,
  'kwantum.nl': parseKwantum_,
  'mattsleeps.com': parseMattsleeps_,
  'beddenreus.nl': parseBeddenreus_,
  'goossenswonen.nl': parseGoossenswonen_
};

/***** ENTRYPOINTS *****/
function checkTrackedProductUrls() {
  processTrackedProductUrls_();
}

function checkSelectedTrackedProductUrls() {
  var ss = SpreadsheetApp.getActive();
  var sheet = ss.getSheetByName(SHEET_INPUT);
  if (!sheet) {
    Logger.log('Sheet "%s" not found.', SHEET_INPUT);
    return;
  }

  var range = ss.getActiveRange();
  if (!range || range.getSheet().getName() !== sheet.getName()) {
    Logger.log('Selecteer eerst rijen op %s.', SHEET_INPUT);
    return;
  }

  var rowSelectionMap = {};
  var startRow = range.getRow();
  var endRow = startRow + range.getNumRows() - 1;
  for (var r = startRow; r <= endRow; r++) {
    if (r >= 2) {
      rowSelectionMap[r] = true;
    }
  }

  if (!Object.keys(rowSelectionMap).length) {
    Logger.log('Geen datarijen geselecteerd.');
    return;
  }

  processTrackedProductUrls_(rowSelectionMap);
}

function testSingleUrl(url) {
  if (!url) {
    Logger.log('Geen URL opgegeven.');
    return;
  }
  var result = fetchHtmlWithPipeline_(url);
  if (result.status !== STATUS.OK) {
    Logger.log('Fetch status: %s (%s)', result.status, result.debug || '-');
    return;
  }
  var parsed = parseProductData_(result.html, url);
  Logger.log('Parsed: %s', JSON.stringify({
    price: parsed.price,
    title: parsed.title,
    brand: parsed.brand,
    ids: parsed.ids,
    status: parsed.status || STATUS.OK,
    debug: result.debug || ''
  }));
}

function diagnoseRow(rowNumber) {
  var ss = SpreadsheetApp.getActive();
  var sheet = ss.getSheetByName(SHEET_INPUT);
  if (!sheet) {
    Logger.log('Sheet "%s" not found.', SHEET_INPUT);
    return;
  }
  var row = Number(rowNumber);
  if (!row || row < 2) {
    Logger.log('Geef een geldig rijnummer ≥ 2.');
    return;
  }
  var rowSelectionMap = {};
  rowSelectionMap[row] = true;
  processTrackedProductUrls_(rowSelectionMap);
}

/***** MAIN PROCESS (BATCH) *****/
function processTrackedProductUrls_(rowSelectionMap) {
  var ss = SpreadsheetApp.getActive();
  var sheet = ss.getSheetByName(SHEET_INPUT);
  if (!sheet) {
    Logger.log('Sheet "%s" not found.', SHEET_INPUT);
    return;
  }

  var headerMap = ensureHeaders_(sheet);
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) {
    Logger.log('Geen datarijen gevonden.');
    return;
  }

  var lastCol = sheet.getLastColumn();
  var dataRange = sheet.getRange(2, 1, lastRow - 1, lastCol);
  var rows = dataRange.getValues();
  var now = new Date();

  var stats = initStats_();

  for (var i = 0; i < rows.length; i++) {
    var rowIndex = i + 2;
    if (rowSelectionMap && !rowSelectionMap[rowIndex]) {
      continue;
    }

    var row = rows[i];
    var url = getCell_(row, headerMap.url);
    if (!url) {
      continue;
    }

    var watchFlag = getCell_(row, headerMap.watch);
    if (watchFlag === '' || watchFlag == null) {
      setCell_(row, headerMap.watch, true);
      watchFlag = true;
    }
    if (!isWatchEnabled_(watchFlag)) {
      continue;
    }

    var fetchResult = fetchHtmlWithPipeline_(url);
    setCell_(row, headerMap.status, fetchResult.status);
    setCell_(row, headerMap.debug, fetchResult.debug || '');
    setCell_(row, headerMap.lastCheck, now);

    if (fetchResult.status !== STATUS.OK) {
      stats[fetchResult.status] = (stats[fetchResult.status] || 0) + 1;
      continue;
    }

    var parsed;
    try {
      parsed = parseProductData_(fetchResult.html, url);
    } catch (err) {
      setCell_(row, headerMap.status, STATUS.PARSE_ERROR);
      setCell_(row, headerMap.debug, 'PARSE_ERROR: ' + err);
      stats[STATUS.PARSE_ERROR] += 1;
      continue;
    }

    if (parsed.status && parsed.status !== STATUS.OK) {
      setCell_(row, headerMap.status, parsed.status);
      stats[parsed.status] = (stats[parsed.status] || 0) + 1;
      continue;
    }

    if (!isFinite(parsed.price)) {
      setCell_(row, headerMap.status, STATUS.PRICE_NOT_FOUND);
      stats[STATUS.PRICE_NOT_FOUND] += 1;
      continue;
    }

    setCell_(row, headerMap.status, STATUS.OK);
    stats[STATUS.OK] += 1;

    if (parsed.title) {
      setCell_(row, headerMap.title, parsed.title);
      if (!getCell_(row, headerMap.product)) {
        setCell_(row, headerMap.product, parsed.title);
      }
    }
    if (parsed.brand) {
      setCell_(row, headerMap.brandScraped, parsed.brand);
      if (!getCell_(row, headerMap.brand)) {
        setCell_(row, headerMap.brand, parsed.brand);
      }
    }
    if (parsed.ids) {
      setCell_(row, headerMap.ids, parsed.ids);
      if (!getCell_(row, headerMap.productId)) {
        var primaryId = extractPrimaryId_(parsed.ids);
        if (primaryId) {
          setCell_(row, headerMap.productId, primaryId);
        }
      }
    }

    var lastPrice = toNumberOrNull_(getCell_(row, headerMap.lastPrice));
    var previousPrice = lastPrice;
    var lowestPrice = toNumberOrNull_(getCell_(row, headerMap.lowestPrice));

    setCell_(row, headerMap.previousPrice, previousPrice);
    setCell_(row, headerMap.lastPrice, parsed.price);

    if (lowestPrice == null) {
      lowestPrice = parsed.price;
    } else {
      lowestPrice = Math.min(lowestPrice, parsed.price);
    }
    setCell_(row, headerMap.lowestPrice, lowestPrice);

    var pctDrop = null;
    if (previousPrice && previousPrice > 0) {
      pctDrop = (previousPrice - parsed.price) / previousPrice;
    }
    setCell_(row, headerMap.pctDrop, pctDrop);
  }

  dataRange.setValues(rows);
  logSummary_(stats);
}

/***** FETCH PIPELINE + DETECTION *****/
function fetchHtmlWithPipeline_(url) {
  var strategies = [
    {
      name: 'A',
      url: url,
      options: {
        followRedirects: true,
        muteHttpExceptions: true,
        method: 'get',
        headers: buildHeaders_('nl-NL,nl;q=0.9,en-US;q=0.8,en;q=0.7', url)
      }
    },
    {
      name: 'B',
      url: withCacheBuster_(url),
      options: {
        followRedirects: true,
        muteHttpExceptions: true,
        method: 'get',
        headers: buildHeaders_('en-US,en;q=0.9,nl;q=0.8', url)
      }
    }
  ];

  var lastResponse = null;

  for (var i = 0; i < strategies.length; i++) {
    var strategy = strategies[i];
    try {
      var resp = UrlFetchApp.fetch(strategy.url, strategy.options);
      lastResponse = resp;
      var code = resp.getResponseCode();
      var html = resp.getContentText() || '';
      var finalUrl = getFinalUrl_(resp, strategy.url);
      var finalHost = safeHost_(finalUrl);

      var blockInfo = detectBlockSignals_(html);
      if (blockInfo) {
        return {
          status: blockInfo.status,
          html: null,
          debug: buildDebugInfo_(code, finalHost, blockInfo.reason)
        };
      }

      if (code === 200) {
        return {
          status: STATUS.OK,
          html: html,
          debug: buildDebugInfo_(code, finalHost, strategy.name)
        };
      }

      if (code === 403 || code === 429) {
        continue;
      }
    } catch (err) {
      lastResponse = null;
    }
  }

  if (lastResponse) {
    var lastCode = lastResponse.getResponseCode();
    var lastUrl = getFinalUrl_(lastResponse, url);
    var lastHost = safeHost_(lastUrl);
    if (lastCode === 403) {
      return {
        status: STATUS.HTTP_403,
        html: null,
        debug: buildDebugInfo_(lastCode, lastHost, 'HTTP_403')
      };
    }
    if (lastCode === 429) {
      return {
        status: STATUS.HTTP_429,
        html: null,
        debug: buildDebugInfo_(lastCode, lastHost, 'HTTP_429')
      };
    }
    return {
      status: STATUS.UNSUPPORTED,
      html: null,
      debug: buildDebugInfo_(lastCode, lastHost, 'NON_200')
    };
  }

  return {
    status: STATUS.UNSUPPORTED,
    html: null,
    debug: 'FETCH_FAILED'
  };
}

function detectBlockSignals_(html) {
  if (!html) return null;
  var text = String(html).toLowerCase();
  var jsRequiredSignals = [
    'enable javascript',
    'checking your browser',
    'cf-chl',
    'cloudflare',
    'attention required',
    'perimeterx',
    'px-captcha'
  ];
  for (var i = 0; i < jsRequiredSignals.length; i++) {
    if (text.indexOf(jsRequiredSignals[i]) !== -1) {
      return { status: STATUS.JS_REQUIRED, reason: jsRequiredSignals[i] };
    }
  }

  var blockedSignals = [
    'access denied',
    '403 forbidden',
    'captcha',
    'blocked'
  ];
  for (var j = 0; j < blockedSignals.length; j++) {
    if (text.indexOf(blockedSignals[j]) !== -1) {
      return { status: STATUS.BLOCKED, reason: blockedSignals[j] };
    }
  }
  return null;
}

function buildHeaders_(acceptLanguage, url) {
  return {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36',
    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
    'Accept-Language': acceptLanguage,
    'Referer': getOrigin_(url)
  };
}

function withCacheBuster_(url) {
  var joiner = url.indexOf('?') === -1 ? '?' : '&';
  return url + joiner + 'cb=' + new Date().getTime();
}

function getOrigin_(url) {
  try {
    var parsed = new URL(url);
    return parsed.origin;
  } catch (e) {
    return url;
  }
}

function safeHost_(url) {
  try {
    return new URL(url).hostname.replace(/^www\./i, '');
  } catch (e) {
    return '';
  }
}

function getFinalUrl_(resp, fallbackUrl) {
  try {
    if (typeof resp.getFinalUrl === 'function') {
      return resp.getFinalUrl();
    }
  } catch (e) {}
  return fallbackUrl;
}

function buildDebugInfo_(code, host, reason) {
  var parts = [];
  if (code) parts.push('code=' + code);
  if (host) parts.push('host=' + host);
  if (reason) parts.push('reason=' + reason);
  return parts.join(' | ');
}

/***** PARSERS (GENERIC + DOMAIN) *****/
function parseProductData_(html, url) {
  var host = safeHost_(url);
  var parser = DOMAIN_PARSERS[host];
  var parsed = parser ? parser(html, url) : null;

  if (!parsed || !isFinite(parsed.price)) {
    parsed = parseGeneric_(html);
  }

  parsed.title = parsed.title || parseTitleFromHtml_(html);
  parsed.brand = parsed.brand || parseBrandFromHtml_(html);
  parsed.ids = parsed.ids || parseIdsFromHtml_(html);

  return parsed;
}

function parseGeneric_(html) {
  return {
    price: parsePriceFromHtml_(html),
    title: '',
    brand: '',
    ids: ''
  };
}

function parseBeliani_(html) {
  var price = null;
  var priceMatch = /"price"\s*:\s*"?([\d.,]+)"?/i.exec(html);
  if (priceMatch) {
    price = parsePrice_(priceMatch[1]);
  }
  if (!price) {
    price = parsePriceFromHtml_(html);
  }
  return {
    price: price,
    title: parseTitleFromHtml_(html),
    brand: parseBrandFromHtml_(html),
    ids: parseIdsFromHtml_(html)
  };
}

function parseKwantum_(html) {
  var price = null;
  var priceMatch = /data-price\s*=\s*"([\d.,]+)"/i.exec(html) ||
    /"price"\s*:\s*"?([\d.,]+)"?/i.exec(html);
  if (priceMatch) {
    price = parsePrice_(priceMatch[1]);
  }
  if (!price) {
    price = parsePriceFromHtml_(html);
  }
  return {
    price: price,
    title: parseTitleFromHtml_(html),
    brand: parseBrandFromHtml_(html),
    ids: parseIdsFromHtml_(html)
  };
}

function parseMattsleeps_() {
  return null;
}

function parseBeddenreus_() {
  return null;
}

function parseGoossenswonen_() {
  return null;
}

function parseTitleFromHtml_(html) {
  if (!html) return '';
  var ogMatch = /<meta[^>]*property=["']og:title["'][^>]*content=["']([^"']+)["'][^>]*>/i.exec(html);
  if (ogMatch) return ogMatch[1].trim();
  var titleMatch = /<title>([^<]{3,})<\/title>/i.exec(html);
  if (titleMatch) return titleMatch[1].trim();
  var h1Match = /<h1[^>]*>([^<]{3,})<\/h1>/i.exec(html);
  return h1Match ? h1Match[1].trim() : '';
}

function parseBrandFromHtml_(html) {
  if (!html) return '';
  var ldMatch = /"brand"\s*:\s*\{"name"\s*:\s*"([^"]+)"/i.exec(html) ||
    /"brand"\s*:\s*"([^"]+)"/i.exec(html);
  if (ldMatch) return ldMatch[1].trim();
  var metaMatch = /<meta[^>]*itemprop=["']brand["'][^>]*content=["']([^"']+)["'][^>]*>/i.exec(html);
  return metaMatch ? metaMatch[1].trim() : '';
}

function parseIdsFromHtml_(html) {
  if (!html) return '';
  var found = { sku: '', mpn: '', gtin: '' };

  try {
    var scriptRegex = /<script[^>]*type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi;
    var m;
    while ((m = scriptRegex.exec(html)) !== null) {
      var jsonText = (m[1] || '').trim();
      if (!jsonText) continue;
      try {
        var data = JSON.parse(jsonText);
        var items = Array.isArray(data) ? data : [data];
        for (var i = 0; i < items.length; i++) {
          deepExtractIds_(items[i], found);
          if (found.gtin && found.sku && found.mpn) break;
        }
      } catch (e) {}
      if (found.gtin && found.sku && found.mpn) break;
    }
  } catch (e) {}

  var ids = [];
  if (found.gtin) ids.push('gtin:' + found.gtin);
  if (found.sku) ids.push('sku:' + found.sku);
  if (found.mpn) ids.push('mpn:' + found.mpn);
  return ids.join(';');
}

function deepExtractIds_(obj, found) {
  if (!obj || typeof obj !== 'object') return;
  if (!found.sku && obj.sku) found.sku = String(obj.sku).trim();
  if (!found.mpn && obj.mpn) found.mpn = String(obj.mpn).trim();
  if (!found.gtin) {
    if (obj.gtin13) found.gtin = String(obj.gtin13).trim();
    else if (obj.gtin14) found.gtin = String(obj.gtin14).trim();
    else if (obj.gtin12) found.gtin = String(obj.gtin12).trim();
    else if (obj.gtin8) found.gtin = String(obj.gtin8).trim();
    else if (obj.gtin) found.gtin = String(obj.gtin).trim();
  }

  if (Array.isArray(obj)) {
    for (var i = 0; i < obj.length; i++) deepExtractIds_(obj[i], found);
  } else {
    for (var k in obj) {
      if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;
      var v = obj[k];
      if (v && typeof v === 'object') deepExtractIds_(v, found);
    }
  }
}

function parsePriceFromHtml_(html) {
  if (!html) return null;

  var candidates = [];
  var jsonCandidates = extractPricesFromJsonLd_(html);
  jsonCandidates.forEach(function(value) {
    candidates.push({ value: value, weight: 3, source: 'jsonld' });
  });

  var metaMatch = /<meta[^>]*itemprop=["']price["'][^>]*content=["']([^"']+)["'][^>]*>/i.exec(html);
  if (metaMatch) {
    var metaPrice = parsePrice_(metaMatch[1]);
    if (isFinite(metaPrice)) {
      candidates.push({ value: metaPrice, weight: 3, source: 'meta' });
    }
  }

  var dataAttrRegex = /data-(?:price|amount|product-price)=["']([^"']+)["']/gi;
  var dataMatch;
  while ((dataMatch = dataAttrRegex.exec(html)) !== null) {
    var dataPrice = parsePrice_(dataMatch[1]);
    if (isFinite(dataPrice)) {
      candidates.push({ value: dataPrice, weight: 2, source: 'data' });
    }
  }

  var regexMatches = extractEuroCandidates_(html);
  regexMatches.forEach(function(candidate) {
    candidates.push(candidate);
  });

  return selectBestPrice_(candidates);
}

function extractPricesFromJsonLd_(html) {
  var results = [];
  try {
    var scriptRegex = /<script[^>]*type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi;
    var match;
    while ((match = scriptRegex.exec(html)) !== null) {
      var jsonText = match[1].trim();
      if (!jsonText) continue;
      try {
        var data = JSON.parse(jsonText);
        var items = Array.isArray(data) ? data : [data];
        items.forEach(function(item) {
          collectPricesFromObject_(item, results);
        });
      } catch (e) {}
    }
  } catch (e) {}
  return results;
}

function collectPricesFromObject_(obj, results) {
  if (!obj || typeof obj !== 'object') return;

  if (obj.price != null) {
    var p = parsePrice_(obj.price);
    if (isFinite(p)) results.push(p);
  }

  if (obj.priceSpecification && obj.priceSpecification.price != null) {
    var specPrice = parsePrice_(obj.priceSpecification.price);
    if (isFinite(specPrice)) results.push(specPrice);
  }

  if (obj.offers) {
    var offers = Array.isArray(obj.offers) ? obj.offers : [obj.offers];
    offers.forEach(function(offer) {
      if (offer.price != null) {
        var offerPrice = parsePrice_(offer.price);
        if (isFinite(offerPrice)) results.push(offerPrice);
      }
      if (offer.priceSpecification && offer.priceSpecification.price != null) {
        var offerSpec = parsePrice_(offer.priceSpecification.price);
        if (isFinite(offerSpec)) results.push(offerSpec);
      }
    });
  }

  if (obj.aggregateOffer) {
    if (obj.aggregateOffer.lowPrice != null) {
      var lowPrice = parsePrice_(obj.aggregateOffer.lowPrice);
      if (isFinite(lowPrice)) results.push(lowPrice);
    }
    if (obj.aggregateOffer.highPrice != null) {
      var highPrice = parsePrice_(obj.aggregateOffer.highPrice);
      if (isFinite(highPrice)) results.push(highPrice);
    }
  }

  if (Array.isArray(obj)) {
    obj.forEach(function(child) { collectPricesFromObject_(child, results); });
  } else {
    for (var key in obj) {
      if (!Object.prototype.hasOwnProperty.call(obj, key)) continue;
      var value = obj[key];
      if (value && typeof value === 'object') {
        collectPricesFromObject_(value, results);
      }
    }
  }
}

function extractEuroCandidates_(html) {
  var candidates = [];
  var regex = /(?:€|&euro;)\s*([\d\.,]+)/gi;
  var match;
  while ((match = regex.exec(html)) !== null) {
    var raw = match[1];
    var value = parsePrice_(raw);
    if (!isFinite(value)) continue;
    var start = Math.max(match.index - 100, 0);
    var end = Math.min(match.index + 100, html.length);
    var context = html.slice(start, end).toLowerCase();
    var contextScore = context.indexOf('price') !== -1 || context.indexOf('prijs') !== -1 ? 1 : 0;
    candidates.push({ value: value, weight: 1 + contextScore, source: 'regex' });
  }
  return candidates;
}

function selectBestPrice_(candidates) {
  if (!candidates.length) return null;

  var plausible = candidates.filter(function(c) {
    return c.value >= 5 && c.value <= 15000;
  });
  var pool = plausible.length ? plausible : candidates;

  var counts = {};
  pool.forEach(function(c) {
    var key = c.value.toFixed(2);
    if (!counts[key]) counts[key] = { count: 0, value: c.value, weight: 0 };
    counts[key].count += 1;
    counts[key].weight = Math.max(counts[key].weight, c.weight);
  });

  var best = null;
  for (var k in counts) {
    var entry = counts[k];
    if (!best) {
      best = entry;
      continue;
    }
    if (entry.count > best.count) {
      best = entry;
      continue;
    }
    if (entry.count === best.count && entry.weight > best.weight) {
      best = entry;
      continue;
    }
    if (entry.count === best.count && entry.weight === best.weight && entry.value < best.value) {
      best = entry;
    }
  }

  return best ? best.value : null;
}

function parsePrice_(value) {
  if (value == null) return null;
  if (typeof value === 'number') {
    return isFinite(value) ? value : null;
  }
  var s = String(value).trim();
  if (!s) return null;
  s = s.replace(/[^0-9.,-]/g, '');
  if (!s) return null;

  var hasComma = s.indexOf(',') !== -1;
  var hasDot = s.indexOf('.') !== -1;

  if (hasComma && hasDot) {
    if (s.lastIndexOf(',') > s.lastIndexOf('.')) {
      s = s.replace(/\./g, '');
      s = s.replace(',', '.');
    } else {
      s = s.replace(/,/g, '');
    }
  } else if (hasComma && !hasDot) {
    s = s.replace(/\./g, '');
    s = s.replace(',', '.');
  } else if (hasDot && !hasComma) {
    var parts = s.split('.');
    if (parts.length > 2) {
      var dec = parts.pop();
      s = parts.join('') + '.' + dec;
    }
  }

  var n = parseFloat(s);
  return isFinite(n) ? n : null;
}

/***** HELPERS *****/
function ensureHeaders_(sheet) {
  var headerRow = sheet.getRange(1, 1, 1, Math.max(1, sheet.getLastColumn())).getValues()[0];
  var headerMap = {};
  var headers = headerRow.slice();

  REQUIRED_HEADERS.forEach(function(def) {
    var idx = headers.indexOf(def.name);
    if (idx === -1) {
      headers.push(def.name);
      idx = headers.length - 1;
    }
    headerMap[def.key] = idx;
  });

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  return headerMap;
}

function getCell_(row, index) {
  if (index == null || index < 0) return '';
  return row[index];
}

function setCell_(row, index, value) {
  if (index == null || index < 0) return;
  row[index] = value;
}

function isWatchEnabled_(flag) {
  if (flag === true) return true;
  if (typeof flag === 'string') {
    var text = flag.trim().toLowerCase();
    return ['ja', 'yes', 'y', 'true', '1'].indexOf(text) !== -1;
  }
  return false;
}

function toNumberOrNull_(value) {
  var num = typeof value === 'number' ? value : parseFloat(value);
  return isFinite(num) ? num : null;
}

function extractPrimaryId_(idsString) {
  if (!idsString) return '';
  var gtin = extractIdValue_(idsString, 'gtin');
  if (gtin) return gtin;
  var sku = extractIdValue_(idsString, 'sku');
  if (sku) return sku;
  var mpn = extractIdValue_(idsString, 'mpn');
  if (mpn) return mpn;
  return '';
}

function extractIdValue_(idsString, key) {
  var parts = String(idsString || '').split(';');
  var searchKey = String(key || '').toLowerCase();
  for (var i = 0; i < parts.length; i++) {
    var p = parts[i].trim();
    if (!p) continue;
    var idx = p.indexOf(':');
    if (idx === -1) continue;
    var k = p.slice(0, idx).trim().toLowerCase();
    var v = p.slice(idx + 1).trim();
    if (k === searchKey && v) return v;
  }
  return '';
}

function initStats_() {
  var stats = {};
  stats[STATUS.OK] = 0;
  stats[STATUS.BLOCKED] = 0;
  stats[STATUS.JS_REQUIRED] = 0;
  stats[STATUS.PRICE_NOT_FOUND] = 0;
  stats[STATUS.HTTP_403] = 0;
  stats[STATUS.HTTP_429] = 0;
  stats[STATUS.UNSUPPORTED] = 0;
  stats[STATUS.PARSE_ERROR] = 0;
  return stats;
}

function logSummary_(stats) {
  Logger.log(
    'Run summary: OK=%s BLOCKED=%s JS_REQUIRED=%s PRICE_NOT_FOUND=%s HTTP_403=%s HTTP_429=%s UNSUPPORTED=%s PARSE_ERROR=%s',
    stats[STATUS.OK],
    stats[STATUS.BLOCKED],
    stats[STATUS.JS_REQUIRED],
    stats[STATUS.PRICE_NOT_FOUND],
    stats[STATUS.HTTP_403],
    stats[STATUS.HTTP_429],
    stats[STATUS.UNSUPPORTED],
    stats[STATUS.PARSE_ERROR]
  );
}
