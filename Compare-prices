// Meervoudige zoekopties per product (naam + optioneel GTIN)
function prijsAgentConcurrenten() {
  if (!SERPAPI_KEY) throw new Error('SERPAPI_API_KEY ontbreekt (Project Settings → Script properties).');

  const ss = SpreadsheetApp.getActive();
  const input = ss.getSheetByName(SHEET_INPUT);
  if (!input) throw new Error(`Tabblad ${SHEET_INPUT} ontbreekt.`);

  const queries = readQueries_(input);          // [{row, query, searchTerms}]
  if (!queries.length) return;

  const history = ensureSheet_(ss, SHEET_HISTORY, [
    'Product', 'Leverancier', 'URL', 'Prijs', 'Valuta', 'Gezocht op'
  ]);
  const snap    = ensureSheet_(ss, SHEET_SNAPSHOT, [
    'Product', 'Leverancier', 'URL', 'Huidige prijs', 'Laatste prijs', 'Laagste prijs ooit', '% korting t.o.v. laatste', 'Laatst gecheckt'
  ]);

  // bouw in-memory prijs-historiek (laatste & laagste per product+leverancier)
  const histIndex = buildHistoryIndex_(history);

  const now = new Date();
  const appendRows = [];   // voor Prijshistorie
  const snapshotRows = []; // voor Concurrenten (we schrijven daarna in bulk)

  for (const {query, searchTerms} of queries) {
    // 1) haal kandidaten op (hoofdvraag + optionele GTIN)
    const items = uniqueByLink_(searchTerms.flatMap(term => searchGoogleShopping_(term)));

    // 2) whitelist-filter
    const allowed = items.filter(it => isWhitelisted_(it.store));

    // 3) voor elk resultaat: append naar historie + updaten van “laatste”/“laagste”
    for (const it of allowed) {
      const key  = makeKey_(query, it.store);
      const last = histIndex.get(key)?.last ?? null;
      const low  = histIndex.get(key)?.low  ?? null;

      // schrijf naar historie-buffer
      appendRows.push([query, it.store, it.link, it.price, it.currency || 'EUR', now]);

      // update index voor volgende hits binnen deze run
      const newLast = it.price;
      const newLow  = (low == null) ? it.price : Math.min(low, it.price);
      histIndex.set(key, { last: newLast, low: newLow });

      // rij klaarzetten voor snapshot; % korting (kolom G) vullen we met sheet-formule
      snapshotRows.push([
        query,                // A Product
        it.store,             // B Leverancier
        it.link,              // C URL
        it.price,             // D Huidige prijs
        last,                 // E Laatste prijs
        newLow,               // F Laagste prijs ooit
        '',                   // G % korting (komt als formule)
        now                   // H Laatst gecheckt
      ]);
    }
  }

  // 4) flush append naar Historie (SAFE)
  if (appendRows.length) {
    const historyLast = history.getLastRow();     // header = 1 als leeg
    const start = historyLast + 1;                // eerste vrije rij
    history.insertRowsAfter(historyLast, appendRows.length);
    history.getRange(start, 1, appendRows.length, appendRows[0].length).setValues(appendRows);
  }

  // 5) ververs snapshot-tab
  clearKeepHeader_(snap);
  if (snapshotRows.length) {
    snap.insertRowsAfter(1, snapshotRows.length);
    snap.getRange(2, 1, snapshotRows.length, snapshotRows[0].length).setValues(snapshotRows);

    // 6) % korting-formule + formats
    const lastRow = 1 + snapshotRows.length;
    for (let r = 2; r <= lastRow; r++) {
      snap.getRange(r, 7).setFormula(`=ALS.FOUT((E${r}-D${r})/E${r};0)`); // kolom G
    }
    snap.getRange(2, 4, snapshotRows.length, 3).setNumberFormat('€ #,##0.00'); // D:E:F
    snap.getRange(2, 7, snapshotRows.length, 1).setNumberFormat('0,0%');       // G
    snap.getRange(2, 8, snapshotRows.length, 1).setNumberFormat('dd-mm-yyyy hh:mm'); // H
  }
}

/***** Helpers *****/
function readQueries_(sheet) {
  // leest C2:C (zoekterm) + optioneel D2:D (GTIN); stopt bij lege rij in beide kolommen
  const startCol = 3; // C
  const rows = sheet.getRange(2, startCol, Math.max(1, sheet.getLastRow() - 1), 2).getValues();
  const out = [];
  for (let i = 0; i < rows.length; i++) {
    const query = String(rows[i][0] || '').trim();
    const gtin  = String(rows[i][1] || '').trim();
    if (!query && !gtin) continue;

    const searchTerms = [];
    if (query) searchTerms.push(query);
    if (gtin)  searchTerms.push(gtin);

    out.push({ row: 2 + i, query: query || gtin, searchTerms });
  }
  return out;
}

function ensureSheet_(ss, name, headers) {
  let sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
  }
  if (sh.getLastRow() === 0) {
    sh.appendRow(headers);
  } else {
    // zorg dat headers kloppen (optioneel)
    const firstRow = sh.getRange(1, 1, 1, headers.length).getValues()[0];
    const mismatch = headers.some((h, i) => firstRow[i] !== h);
    if (mismatch) {
      sh.clearContents();
      sh.appendRow(headers);
    }
  }
  return sh;
}

function clearKeepHeader_(sh) {
  const last = sh.getLastRow();
  if (last > 1) sh.getRange(2, 1, last - 1, sh.getMaxColumns()).clearContent();
}

// PATCH: robuuste whitelist (namen én domeinen)
function isWhitelisted_(store) {
  const s = (store || '').toLowerCase();
  if (!s) return false;
  const alias = s
    .replace(/^www\./,'')
    .replace(/\.nl$|\.com$|\.be$|\.de$/,'')
    .replace(/-|\s/g,''); // baby-dump.nl -> babydump
  return WHITELIST.some(w => {
    const wnorm = w.toLowerCase().replace(/-|\s/g,'');
    return s.includes(wnorm) || alias.includes(wnorm);
  });
}

function makeKey_(product, store) {
  return `${product}__${store}`.toLowerCase();
}

function buildHistoryIndex_(historySheet) {
  // leest hele historie en bouwt {last, low} per (product, leverancier)
  const lastRow = historySheet.getLastRow();
  const idx = new Map();
  if (lastRow < 2) return idx;

  const vals = historySheet.getRange(2, 1, lastRow - 1, 6).getValues();
  // Kolommen: Product, Leverancier, URL, Prijs, Valuta, Gezocht op
  for (let i = 0; i < vals.length; i++) {
    const [product, store, , price] = vals[i];
    const key = makeKey_(product, store);
    const rec = idx.get(key) || { last: null, low: null };
    rec.last = price;                             // laatste = onderaan
    rec.low  = rec.low == null ? price : Math.min(rec.low, price);
    idx.set(key, rec);
  }
  return idx;
}

// dedupliceer resultaten per unieke link (handig bij meerdere zoektermen/GTIN)
function uniqueByLink_(items) {
  const seen = new Set();
  return items.filter(it => {
    const key = it.link;
    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

/***** SerpAPI wrapper (PATCH: store-fallback + logging) *****/
function searchGoogleShopping_(query) {
  const params = {
    engine: 'google_shopping',
    q: query,
    hl: 'nl',
    gl: 'nl',
    api_key: SERPAPI_KEY
  };
  const url = 'https://serpapi.com/search.json?' + toQueryString_(params);
  const resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
  const code = resp.getResponseCode();
  if (code !== 200) {
    Logger.log('SerpAPI HTTP ' + code + ' → ' + resp.getContentText());
    return [];
  }
  const json = JSON.parse(resp.getContentText());
  const items = json.shopping_results || [];

  const mapped = items.map(it => {
    let link  = it.link || it.product_link || '';
    let store = it.source || it.source_id || (it.sellers && it.sellers[0]?.source) || '';
    if (!store && link) {
      try { store = new URL(link).hostname.replace(/^www\./,''); } catch(e) {}
    }
    return {
      title: it.title || '',
      store,
      price: parsePrice_(it.extracted_price ?? it.price),
      currency: it.currency || 'EUR',
      link
    };
  }).filter(x => x.price != null && x.link);

  Logger.log(`[SERP] "${query}" → ${items.length} items / na mapping ${mapped.length}`);
  mapped.slice(0,5).forEach((m,i)=>Logger.log(`#${i+1} ${m.store} | €${m.price} | ${m.title}`));
  return mapped;
}

function parsePrice_(v) {
  if (v == null) return null;
  if (typeof v === 'number') return v;
  let s = String(v).replace(/[^\d,\.]/g, '').replace(/\./g, '').replace(',', '.');
  const n = parseFloat(s);
  return isNaN(n) ? null : n;
}
function toQueryString_(obj) {
  return Object.keys(obj).map(k => encodeURIComponent(k) + '=' + encodeURIComponent(obj[k])).join('&');
}

// Zorgt dat de sheet "Concurrenten-2" bestaat met de juiste headers
