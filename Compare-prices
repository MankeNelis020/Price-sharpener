/***** CONFIG *****/
const SHEET_INPUT   = 'Blad1';
const SHEET_SNAPSHOT = 'Concurrenten';
const SERPAPI_KEY   = PropertiesService.getScriptProperties().getProperty('SERPAPI_API_KEY');

// Whitelisted competitor domains
const WHITELIST_DOMAINS = [
  'babypark.nl',
  'baby-dump.nl',
  'prenatal.nl',
  'babyentiener.nl',
  'babyplanet.nl',
  'mamaloes.nl'
];

/***** MAIN WORKFLOW *****/
// Runs the SerpAPI-based competitor check for all products in Blad1.
function runDailyPriceCheck() {
  if (!SERPAPI_KEY) throw new Error('SERPAPI_API_KEY ontbreekt (Project Settings → Script properties).');

  var products = getProductList();
  if (!products.length) return;

  var snapshot = ensureSnapshotSheet_();
  var index = buildSnapshotIndex_(snapshot);
  var drops = [];
  var now = new Date();

  products.forEach(function (product) {
    var results = fetchSerpApiPrices(product);
    updateCompetitorsSheet(product, results, snapshot, index, drops, now);
  });

  drops.forEach(function (drop) {
    notifyPriceDrop(drop.product, drop.store, drop.url, drop.oldLow, drop.newPrice);
  });
}

/***** SERPAPI FETCH *****/
// Calls SerpAPI Shopping for a product (by GTIN if present, otherwise by name).
function fetchSerpApiPrices(product) {
  var query = product.productId ? String(product.productId).trim() : String(product.name || '').trim();
  if (!query) return [];

  var params = {
    engine: 'google_shopping',
    q: query,
    hl: 'nl',
    gl: 'nl',
    api_key: SERPAPI_KEY
  };
  var url = 'https://serpapi.com/search.json?' + toQueryString_(params);
  var resp;
  try {
    resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
  } catch (e) {
    Logger.log('SerpAPI fetch error for ' + query + ': ' + e);
    return [];
  }
  if (resp.getResponseCode() !== 200) {
    Logger.log('SerpAPI HTTP ' + resp.getResponseCode() + ' for ' + query + ': ' + resp.getContentText());
    return [];
  }

  var json = JSON.parse(resp.getContentText());
  var items = json.shopping_results || [];
  var mapped = [];
  for (var i = 0; i < items.length; i++) {
    var it = items[i];
    var link = it.link || it.product_link || '';
    if (!isAllowedDomain_(link)) continue;
    var store = it.source || it.source_id || '';
    if (!store && link) {
      try { store = new URL(link).hostname.replace(/^www\./, ''); } catch (e) {}
    }
    var price = parsePrice_(it.extracted_price != null ? it.extracted_price : it.price);
    if (price == null || !link) continue;
    mapped.push({
      title: it.title || '',
      store: store || '',
      price: price,
      currency: it.currency || 'EUR',
      link: link
    });
  }

  Logger.log('SerpAPI "' + query + '" → ' + mapped.length + ' whitelisted items');
  return mapped;
}

/***** SHEET UPDATES *****/
// Updates the Concurrenten sheet with latest prices and records price drops.
function updateCompetitorsSheet(product, results, snapshot, index, drops, now) {
  results.forEach(function (result) {
    var key = makeKey_(product, result.store);
    var rowInfo = index.get(key);
    var currentPrice = result.price;
    var lastPrice = '';
    var lowestPrice = currentPrice;

    if (rowInfo) {
      var rowVals = rowInfo.values;
      var previousCurrent = rowVals[3];
      var previousLow = rowVals[5];
      lastPrice = previousCurrent;
      if (previousLow !== '' && previousLow != null) {
        lowestPrice = Math.min(Number(previousLow), currentPrice);
        if (currentPrice < Number(previousLow)) {
          drops.push({ product: product, store: result.store, url: result.link, oldLow: previousLow, newPrice: currentPrice });
        }
      }
      var update = [
        product.name,
        result.store,
        result.link,
        currentPrice,
        lastPrice,
        lowestPrice,
        '',
        now
      ];
      snapshot.getRange(rowInfo.row, 1, 1, update.length).setValues([update]);
      snapshot.getRange(rowInfo.row, 7).setFormula('=IFERROR((E' + rowInfo.row + '-D' + rowInfo.row + ')/E' + rowInfo.row + ',0)');
      index.set(key, { row: rowInfo.row, values: update });
    } else {
      var newRow = snapshot.getLastRow() + 1;
      var insert = [
        product.name,
        result.store,
        result.link,
        currentPrice,
        '',
        currentPrice,
        '',
        now
      ];
      snapshot.appendRow(insert);
      snapshot.getRange(newRow, 7).setFormula('=IFERROR((E' + newRow + '-D' + newRow + ')/E' + newRow + ',0)');
      index.set(key, { row: newRow, values: insert });
    }
  });
}

/***** NOTIFICATIONS *****/
// Sends an email when a new lowest price is detected.
function notifyPriceDrop(product, store, url, oldLow, newPrice) {
  var subject = '[Prijsdaling] ' + (product.name || product.productId);
  var body = 'Shop: ' + store + '\n' +
             'Product: ' + (product.name || '') + '\n' +
             'Oude laagste prijs: ' + (oldLow || '') + '\n' +
             'Nieuwe prijs: ' + newPrice + '\n' +
             'URL: ' + url;
  var recipient = Session.getActiveUser().getEmail();
  MailApp.sendEmail(recipient, subject, body);
}

/***** INPUT *****/
// Reads products from Blad1; expects headers with Product and ProductId.
function getProductList() {
  var ss = SpreadsheetApp.getActive();
  var sh = ss.getSheetByName(SHEET_INPUT);
  if (!sh) return [];
  var last = sh.getLastRow();
  if (last < 2) return [];

  var headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
  var map = headerMap_(headers);
  var idxName = map['product'];
  var idxId = map['productid'];
  if (idxName == null && idxId == null) return [];

  var data = sh.getRange(2, 1, last - 1, headers.length).getValues();
  var products = [];
  for (var i = 0; i < data.length; i++) {
    var name = idxName != null ? String(data[i][idxName] || '').trim() : '';
    var pid = idxId != null ? String(data[i][idxId] || '').trim() : '';
    if (!name && !pid) continue;
    products.push({ name: name, productId: pid });
  }
  Logger.log('Loaded ' + products.length + ' products from ' + SHEET_INPUT);
  return products;
}

/***** HELPERS *****/
function ensureSnapshotSheet_() {
  var ss = SpreadsheetApp.getActive();
  var sh = ss.getSheetByName(SHEET_SNAPSHOT);
  if (!sh) {
    sh = ss.insertSheet(SHEET_SNAPSHOT);
  }
  var headers = ['Product', 'Leverancier', 'URL', 'Huidige prijs', 'Laatste prijs', 'Laagste prijs ooit', '% korting t.o.v. laatste', 'Laatst gecheckt'];
  if (sh.getLastRow() === 0) {
    sh.appendRow(headers);
  }
  return sh;
}

function buildSnapshotIndex_(sh) {
  var idx = new Map();
  var last = sh.getLastRow();
  if (last < 2) return idx;
  var vals = sh.getRange(2, 1, last - 1, 8).getValues();
  for (var i = 0; i < vals.length; i++) {
    var row = vals[i];
    var key = makeKey_({ name: row[0] }, row[1]);
    idx.set(key, { row: i + 2, values: row });
  }
  return idx;
}

function makeKey_(product, store) {
  var base = product.name ? String(product.name) : String(product.productId || '');
  return (base + '__' + (store || '')).toLowerCase();
}

function toQueryString_(obj) {
  return Object.keys(obj).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]); }).join('&');
}

function parsePrice_(v) {
  if (v == null) return null;
  if (typeof v === 'number') return v;
  var s = String(v).replace(/[^0-9,\.]/g, '').replace(/\./g, '').replace(',', '.');
  var n = parseFloat(s);
  return isNaN(n) ? null : n;
}

function headerMap_(headers) {
  var map = {};
  headers.forEach(function (h, i) {
    var key = String(h || '').trim().toLowerCase();
    if (key) map[key] = i;
  });
  return map;
}

function isAllowedDomain_(url) {
  try {
    var host = new URL(url).hostname.replace(/^www\./, '').toLowerCase();
    return WHITELIST_DOMAINS.some(function (d) { return host.indexOf(d) !== -1; });
  } catch (e) {
    return false;
  }
}
